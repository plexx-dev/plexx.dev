<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <title>rust &lt3</title>
        <meta name="description" content="my website">
        <meta http-equiv="Content-Security-Policy"
            content="default-src 'self'; img-src 'self'; child-src 'none'; frame-src 'none';">
        <link rel="preload" href="/static/main.css" as="style">
        <link rel="preload" href="/static/webfonts/JetBrainsMono-Regular_compact.woff2" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="/static/main.css">
        <link rel="shortcut icon" href="/static/icon.png">
    </head>
    <body>
        <main>
            {% block content %}
            {% endblock %}
        </main>
    </body>
</html>